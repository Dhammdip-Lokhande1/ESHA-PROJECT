# EHSA — Environment Configuration Template
# Copy this file to .env before starting the backend and frontend

# ==============================================================================
# Backend Configuration
# ==============================================================================
# Database connection string (SQLite for dev, Postgres for production)
DATABASE_URL=sqlite+aiosqlite:///./ehsa.db

# HuggingFace Semantic Model Name (Local CPU inference, zero cost)
# Lighter/faster for dev/deploy: microsoft/unixcoder-base
# Full evaluation model:         microsoft/graphcodebert-base
MODEL_NAME=microsoft/unixcoder-base

# CORS Allowed Origins (comma-separated for production frontend URL)
CORS_ORIGINS=http://localhost:3000

# File limits and behavioral timeouts
MAX_FILE_SIZE_BYTES=1048576
BEHAVIORAL_TIMEOUT_SECONDS=2.0
BEHAVIORAL_MAX_MEMORY_BYTES=134217728
AI_GENERATION_THRESHOLD=0.65

# Security & JWT Configuration
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET

# Bootstrap Initial Admin Credentials
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@ehsa.local
INITIAL_ADMIN_PASSWORD=CHANGE_ME_TO_A_SECURE_PASSWORD

# ==============================================================================
# Frontend Configuration
# ==============================================================================
# Backend API Base URL for frontend requests
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

